# ============================================================================
# LLM Model Configuration — Google Gemini via LiteLLM
# All roles use gemini-3.6-flash (verified on new API keys).
# ============================================================================
LLM_SYNDATA_GEN=gemini/gemini-3.6-flash
LLM_PARAM_EXTRACTION=gemini/gemini-3.6-flash
LLM_RESPONSE_GEN=gemini/gemini-3.6-flash
LLM_PLANNER=gemini/gemini-3.6-flash
LLM_AGENT=gemini/gemini-3.6-flash
LLM_CONVERSATION_STORE=gemini/gemini-3.6-flash

# ============================================================================
# Workflow Configuration
# ============================================================================
SPEEDDICT_FOLDERNAME=___workflow_contexts
SYNTHETIC_UTTERANCE_GEN_NUMOF_PERSONAS=4
SYNTHETIC_UTTERANCE_GEN_UTTERANCES_PER_PERSONA=5
SYNTHETIC_UTTERANCE_GEN_PERSONAS_PER_BATCH=1
MISSING_INFORMATION_ERRMSG="Missing parameter values: "
INVALID_INFORMATION_ERRMSG="Invalid parameter values: "
NOT_FOUND="NOT_FOUND"
INVALID="INVALID"
PARAMETER_EXTRACTION_ERROR_MSG="Error in parameter extraction: {error}"
LOG_LEVEL=INFO
