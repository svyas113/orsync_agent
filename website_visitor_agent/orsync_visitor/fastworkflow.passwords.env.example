# Copy to fastworkflow.passwords.env and fill in your keys.
# Never commit the real passwords file.

# LiteLLM / provider keys for training + chat
LITELLM_API_KEY_SYNDATA_GEN=
LITELLM_API_KEY_PARAM_EXTRACTION=
LITELLM_API_KEY_RESPONSE_GEN=
LITELLM_API_KEY_PLANNER=
LITELLM_API_KEY_AGENT=
LITELLM_API_KEY_CONVERSATION_STORE=
GROQ_API_KEY=
# Or use Gemini / OpenAI / etc. matching the model strings in fastworkflow.env
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Gmail SMTP for demo-request notifications to orsyncagents@gmail.com
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_USER=orsyncagents@gmail.com
SMTP_PASSWORD=
SMTP_FROM=orsyncagents@gmail.com
